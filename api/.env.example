# --- Servidor ---
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
# Dominio base de los enlaces públicos (rifastar.co/{org}/{sorteo})
PUBLIC_BASE_URL=http://localhost:5173
LOG_LEVEL=info

# --- Base de datos ---
# Dueño del esquema: solo migraciones (Prisma CLI)
DATABASE_URL=postgresql://rifastar:rifastar@localhost:5432/rifastar
# API: rol sin BYPASSRLS
APP_DATABASE_URL=postgresql://rifastar_app:rifastar_app@localhost:5432/rifastar
# Plataforma, resolución de org y jobs: rol con BYPASSRLS
SYSTEM_DATABASE_URL=postgresql://rifastar_system:rifastar_system@localhost:5432/rifastar

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Seguridad ---
# Secretos de al menos 32 caracteres
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-acceso-000
JWT_PARTICIPANT_SECRET=cambia-esto-por-un-secreto-largo-participante
# Clave AES-256 en base64 (32 bytes) para cifrar secretos TOTP: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# Pepper para el hash de códigos OTP y tokens
HASH_PEPPER=cambia-esto-pepper
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# --- Almacenamiento S3 (MinIO en desarrollo) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rifastar
S3_ACCESS_KEY=rifastar
S3_SECRET_KEY=rifastar-secret
S3_FORCE_PATH_STYLE=true

# --- Correo (Mailpit en desarrollo) ---
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Rifa Star <no-responder@rifastar.co>"

# --- WhatsApp Cloud API (Meta) ---
# fake = no envía nada (desarrollo y tests)
MESSAGING_DRIVER=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Facturación (Stripe) ---
BILLING_DRIVER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
